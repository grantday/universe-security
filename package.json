{
  "name": "universe-security",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "generate:types": "payload generate:types --disable-transpile",
    "generate:importmap": "payload generate:importmap --disable-transpile",
    "payload": "payload",
    "seed:payload": "curl -s -X POST http://localhost:3000/api/dev/seed",
    "seed:payload:ps": "powershell -Command \"Invoke-WebRequest -Uri http://localhost:3000/api/dev/seed -Method POST -UseBasicParsing\"",
    "build:godaddy": "node scripts/package-godaddy.mjs",
    "build:fastcomet": "node scripts/package-godaddy.mjs",
    "build:shared": "cross-env DEPLOY_TARGET=godaddy-shared NEXT_PUBLIC_FORMS_MODE=mailto next build",
    "start:standalone": "node start.cjs",
    "install:ci": "npm ci --legacy-peer-deps --no-overrides",
    "install:deps": "npm install --legacy-peer-deps --no-overrides"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@hookform/resolvers": "^3.9.1",
    "@payloadcms/db-postgres": "^3.85.0",
    "@payloadcms/db-sqlite": "^3.84.1",
    "@payloadcms/next": "^3.84.1",
    "@payloadcms/richtext-lexical": "^3.84.1",
    "@payloadcms/ui": "^3.84.1",
    "@vercel/analytics": "^1.5.0",
    "@vercel/blob": "^0.27.0",
    "@vercel/speed-insights": "^1.2.0",
    "browserslist": "^4.28.2",
    "caniuse-lite": "^1.0.30001793",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "graphql": "^16.14.0",
    "gray-matter": "^4.0.3",
    "jose": "^5.9.6",
    "lucide-react": "^0.460.0",
    "next": "15.4.11",
    "next-mdx-remote": "^6.0.0",
    "payload": "^3.84.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.76.0",
    "react-intersection-observer": "^9.16.0",
    "resend": "^4.0.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.24.0",
    "eslint-config-next": "15.4.11",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.22.3",
    "typescript": "^5.6.3"
  }
}
