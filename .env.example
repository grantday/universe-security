# Public site URL (used for metadata, sitemap, canonical)
NEXT_PUBLIC_SITE_URL=https://universe-security.example.com

# Resend (https://resend.com) — required for contact + emergency email
RESEND_API_KEY=re_xxxxxxxx

# Verified sender in Resend (use your domain after verification)
# Falls back to onboarding@resend.dev for local testing (Resend limits apply)
RESEND_FROM=Universe Security <onboarding@resend.dev>

# Inbound addresses
CONTACT_TO_EMAIL=you@example.com
EMERGENCY_TO_EMAIL=controlroom@example.com
