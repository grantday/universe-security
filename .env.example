# Public site URL (used for metadata, sitemap, canonical)
NEXT_PUBLIC_SITE_URL=https://universe-security.vercel.app

# Sanity CMS (https://sanity.io) — portable across any host
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=

# Resend (https://resend.com) — contact + emergency email
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=Universe Security <onboarding@resend.dev>
CONTACT_TO_EMAIL=you@example.com
EMERGENCY_TO_EMAIL=controlroom@example.com
