# Production site URL (scheme required) — SEO, sitemap, canonical URLs, Open Graph, share links
NEXT_PUBLIC_SITE_URL=https://universe-security.vercel.app
# Local fallback when NEXT_PUBLIC_SITE_URL is unset
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Resend — contact, emergency, and assessment wizard
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=Universe Security <onboarding@resend.dev>
CONTACT_TO_EMAIL=you@example.com
EMERGENCY_TO_EMAIL=controlroom@example.com

# Payload CMS
DATABASE_URI=file:./universe-security.db
PAYLOAD_SECRET=replace-with-openssl-rand-base64-32
PAYLOAD_ADMIN_EMAIL=admin@universe-security.local
PAYLOAD_ADMIN_PASSWORD=choose-a-strong-password

# Legacy (optional) — old Blob admin password; /cms-admin redirects to /studio
ADMIN_PASSWORD=
