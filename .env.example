# Site URL
NEXT_PUBLIC_SITE_URL=https://universe-security.vercel.app

# Built-in content admin at /admin (same Vercel project)
ADMIN_PASSWORD=choose-a-strong-password

# Resend — contact + emergency forms only
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=Universe Security <onboarding@resend.dev>
CONTACT_TO_EMAIL=you@example.com
EMERGENCY_TO_EMAIL=controlroom@example.com

# BLOB_READ_WRITE_TOKEN is auto-added when you create a Blob store in Vercel → Storage
