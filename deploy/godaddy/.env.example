# GoDaddy production — copy to .env in the deploy folder (or set in cPanel → Environment Variables)

# Your live domain (required for SEO, sitemap, forms)
NEXT_PUBLIC_SITE_URL=https://universe-security.org
NEXT_PUBLIC_SERVER_URL=https://universe-security.org

# Payload CMS — generate with: openssl rand -base64 32
PAYLOAD_SECRET=replace-with-openssl-rand-base64-32

# Database (pick one):
# A) SQLite on VPS/cPanel (use an absolute path outside public_html):
# DATABASE_URI=file:/home/YOUR_USER/universe-security.db
# B) Remote Postgres (recommended — free tier at neon.tech):
# DATABASE_URI=postgresql://user:pass@host/db?sslmode=require

DATABASE_URI=file:/home/YOUR_USER/universe-security.db

PAYLOAD_ADMIN_EMAIL=admin@yourdomain.com
PAYLOAD_ADMIN_PASSWORD=choose-a-strong-password

# Studio login (legacy password gate)
ADMIN_PASSWORD=choose-a-strong-studio-password

# Resend — contact & emergency forms
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=Universe Security <noreply@yourdomain.com>
CONTACT_TO_EMAIL=info@universe-security.com
EMERGENCY_TO_EMAIL=info@universe-security.com

# Optional: omit on GoDaddy (site uses JSON content fallback without Blob)
# BLOB_READ_WRITE_TOKEN=
