# Temporary PHP site — basic hardening
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Block direct access to data and includes
  RewriteRule ^data/ - [F,L]
  RewriteRule ^includes/ - [F,L]
</IfModule>

<FilesMatch "\.(jsonl|log)$">
  Require all denied
</FilesMatch>

DirectoryIndex index.php index.html
